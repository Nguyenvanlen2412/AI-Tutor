# Whisper
WHISPER_MODEL=base
WHISPER_LANGUAGE=vi
WHISPER_DEVICE=cpu

# Ollama models
OLLAMA_BASE_URL=http://localhost:11434
CORE_LLM_MODEL=gemini-3.1-flash-lite
REFORMULATION_MODEL=gemini-3.1-flash-lite
LLAMA_GUARD_MODEL=llama-guard3:1b

# Embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DEVICE=cpu

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ai_tutor_docs
QDRANT_PATH=D:/New folder/AI tutor/qdrant_db

# Redis
REDIS_URL=redis://localhost:6379
CACHE_SIMILARITY_THRESHOLD=0.93
CACHE_TTL_SECONDS=3600

# TTS
TTS_BACKEND=kokoro          # kokoro | zalo | viettts
KOKORO_VOICE=af_heart
ZALO_TTS_API_KEY=           # only needed for zalo backend

# Safety
MAX_REGENERATIONS=3
